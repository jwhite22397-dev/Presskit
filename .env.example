# =============================================================================
# PRESSKIT - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from your Supabase project: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# -----------------------------------------------------------------------------
# Stripe Configuration
# -----------------------------------------------------------------------------
# Get these from your Stripe dashboard: https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxxxx
STRIPE_LIFETIME_PRICE_ID=price_xxxxx

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PRESSKIT

# -----------------------------------------------------------------------------
# Development Mode
# -----------------------------------------------------------------------------
# Set to "true" to enable demo mode without external services
NEXT_PUBLIC_DEMO_MODE=true

# Set to simulate a specific plan in demo mode: "free", "pro", "lifetime"
DEMO_BILLING_PLAN=free

# Admin user IDs (comma-separated) for manual plan grants
ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# Optional: Analytics
# -----------------------------------------------------------------------------
# Future: add your analytics provider keys here
